<Window x:Class="MusicPlayer.AddWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MusicPlayer"
        Width="500"
        Height="250"
        Background="#FF3F3F3F"
        Title="Add Album"
        WindowStartupLocation="CenterOwner"
        mc:Ignorable="d">
  <Window.BorderBrush>
    <RadialGradientBrush>
      <RadialGradientBrush.GradientStops>
        <GradientStop Offset="0" Color="#FF606060" />
        <GradientStop Offset="1" Color="#FFFFFFFF" />
      </RadialGradientBrush.GradientStops>
    </RadialGradientBrush>
  </Window.BorderBrush>
  <Grid Width="458" Height="183" Margin="15">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="180" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <Border x:Name="DropArea"
            AllowDrop="True"
            Background="#FF505050"
            BorderBrush="#FF2B2A2A"
            BorderThickness="2"
            CornerRadius="5"
            DragOver="DropArea_DragOver"
            Drop="DropArea_Drop"
            Grid.Column="0">
      <Grid>
        <TextBlock x:Name="HintText"
                   Width="197"
                   Height="24"
                   Margin="0,0,0,0"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   FontFamily="Century Gothic"
                   FontSize="14"
                   Foreground="#FFA0A0A0"
                   Text="Перетащите обложку сюда"
                   TextAlignment="Center"
                   Grid.Column="0"
                   Grid.Row="0" />
        <Image x:Name="AlbumCoverImage"
               Margin="2"
               Stretch="UniformToFill" />
      </Grid>
    </Border>
    <StackPanel Margin="15,0,0,0"
                VerticalAlignment="Center"
                Grid.Column="1">
      <Label Content="Name Album:"
             FontFamily="Century Gothic"
             FontSize="20"
             Foreground="White"
             Padding="0,0,0,5" />
      <TextBox x:Name="AlbumNameTextBox"
               Height="30"
               VerticalContentAlignment="Center"
               Background="#FF686868"
               BorderBrush="#FF2B2A2A"
               FontFamily="Century Gothic"
               FontSize="14"
               Foreground="White"
               Padding="5,0,0,0"
               Text="" />
    </StackPanel>
    <Button Content="Create"
            Width="75"
            Height="23"
            Margin="203,158,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            FontFamily="Century Gothic"
            Background="#FF505050"
            BorderBrush="#FF2B2A2A"
            Click="Create"
            FontSize="15"
           
            Grid.Column="1"
            Grid.Row="0" />
  </Grid>
</Window>