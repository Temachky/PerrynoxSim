<Window x:Class="MusicPlayer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MusicPlayer"
        Width="1200"
        Height="600"
        Background="#FF3F3F3F"
        Title="Perrynox.SIM"
        mc:Ignorable="d">
  <Window.BorderBrush>
    <RadialGradientBrush>
      <RadialGradientBrush.GradientStops>
        <GradientStop Offset="0" Color="#FF686868" />
        <GradientStop Offset="1" Color="#FFFFFFFF" />
      </RadialGradientBrush.GradientStops>
    </RadialGradientBrush>
  </Window.BorderBrush>
  <Grid Width="1193"
        Height="569"
        Margin="15,0,0,0"
        RenderTransformOrigin="0.4514,0.4824">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="0.38448566610455315*" />
      <ColumnDefinition Width="1.9593483705304708*" />
      <ColumnDefinition Width="0.6556962025316455*" />
    </Grid.ColumnDefinitions>
    <Grid Width="743"
          Height="373"
          Margin="18,82,0,0"
          HorizontalAlignment="Left"
          VerticalAlignment="Top"
          Background="#FF2D2D2D"
          RenderTransformOrigin="0.5,0.48"
          x:Name="AlbumPick"
          Grid.Column="1"
          Grid.Row="0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition />
        <ColumnDefinition />
        <ColumnDefinition />
        <ColumnDefinition />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition />
        <RowDefinition />
      </Grid.RowDefinitions>
      <Button Content="+"
              Width="151"
              Height="150"
              Margin="17,18,0,0"
              HorizontalAlignment="Left"
              VerticalAlignment="Top"
              Background="#FF333333"
              BorderBrush="#FF494545"
              FontFamily="Century Gothic"
              Click="Button_Click"
              FontSize="70"
              Grid.Column="3"
              Grid.Row="0" />
    </Grid>
    <Label Content="Your albums:"
           Width="175"
           Height="48"
           Margin="22,34,0,0"
           HorizontalAlignment="Left"
           VerticalAlignment="Top"
           FontFamily="Century Gothic"
           FontSize="25"
           Grid.Column="1"
           Grid.Row="0" />
  </Grid>
</Window>